# Copy to .env and replace every placeholder before starting.
BIOFORGE_DOMAIN=studio.example.com
BIOFORGE_ADMIN_USER=admin
# Only used on a fresh runtime; existing runtime/auth.json keeps its password.
BIOFORGE_ADMIN_PASSWORD=replace-with-a-long-unique-password
BIOFORGE_COOKIE_SECURE=1
BIOFORGE_REQUIRE_AUTH=1
# Read-only literature database from the host. Leave unset to disable the local library.
# BIOFORGE_LITERATURE_DB=/data/literature/bioforge_literature.db
BIOFORGE_LITERATURE_HOST_DIR=./data/literature

# PostgreSQL 16 + pgvector (used by docker compose; do not commit .env)
POSTGRES_USER=bioforge
POSTGRES_PASSWORD=replace-with-a-long-random-db-password
POSTGRES_DB=bioforge
DATABASE_URL=postgresql://bioforge:replace-with-a-long-random-db-password@db:5432/bioforge
# Optional domestic PyPI mirror used during docker build
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# Optional domestic Debian mirror for apt-get during docker build
APT_MIRROR=http://mirrors.tuna.tsinghua.edu.cn
